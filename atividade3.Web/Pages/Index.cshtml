@page
@model atividade3.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Combustíveis";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>⛽ Monitoramento de Combustíveis (ES)</h2>
        <a asp-page="/MenorPreco" class="btn btn-success fw-bold">⚡ Ver Menores Preços</a>
    </div>

    <div class="row">
        @foreach (var item in Model.Combustiveis)
        {
            <div class="col-md-6 col-lg-3 mb-4">
                <div class="card shadow-sm border-0 h-100 bg-light">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <span class="badge bg-secondary mb-2">@item.Categoria</span>
                            <h5 class="card-title fw-bold">@item.Nome</h5>
                            <p class="text-muted small mb-0">Código: @item.Id</p>
                        </div>
                        <a asp-page="/Historico" asp-route-id="@item.Id" class="btn btn-primary btn-sm w-100 mt-3">
                            📊 Ver Gráfico de Preços
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
